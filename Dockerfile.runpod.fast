# syntax=docker/dockerfile:1
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

LABEL org.opencontainers.image.title="manga-translate-v2-fast"
LABEL org.opencontainers.image.description="Prepared local-disk manga environments; real CUDA preflight still required on the Pod"

ENV MANGA_RUNTIME=/opt/manga-work/runtime \
    MANGA_EXECUTION_ROOT=/opt/manga-work/execution \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/manga-work/project
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
# Keep dependency layers independent of ordinary source/prompt edits.
COPY requirements-names.txt requirements-visual-layout.txt requirements-hayai.txt ./
COPY deployment/runpod/manage.py deployment/runpod/requirements.in deployment/runpod/requirements-visual.in deployment/runpod/requirements-hayai.in ./deployment/runpod/

# Build without a GPU; this deliberately records CUDA as NOT verified. A normal
# setup/doctor on the allocated Pod must perform the real checks before inference.
RUN --mount=type=cache,id=manga-uv-cu128,target=/opt/manga-work/execution/cache/uv,sharing=locked \
    --mount=type=cache,id=manga-tool-downloads,target=/opt/manga-work/runtime/cache/downloads,sharing=locked \
    python3 deployment/runpod/manage.py setup --prepare-only

COPY --chown=root:root . /opt/manga-work/project
RUN --mount=type=cache,id=manga-vllm-uv,target=/opt/manga-work/execution/cache/uv,sharing=locked \
    python3 deployment/runpod/vllm_runtime.py setup --config configs/pipeline-v6-runpod.json
RUN python3 -m compileall -q run.py src deployment/runpod scripts \
    && python3 -c "import sys,tempfile,pathlib,json; sys.path.insert(0,'deployment/runpod'); import native_transport as sync; p=pathlib.Path(tempfile.gettempdir())/'manga-image-bundle.zip'; m=sync.bundle(p); pathlib.Path('__bundle__.json').write_text(json.dumps(m),encoding='utf-8'); p.unlink()"

# Inherit the official /start.sh SSH entrypoint and CMD.
