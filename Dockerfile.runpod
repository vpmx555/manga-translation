# syntax=docker/dockerfile:1

# Keep this tag aligned with deployment/runpod/template.json. The official
# Runpod image supplies the CUDA/PyTorch stack and /start.sh for pod SSH.
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

LABEL org.opencontainers.image.title="manga-translate-v2"
LABEL org.opencontainers.image.description="Reusable Runpod pod image for the manga translation pipeline"

ENV MANGA_RUNTIME=/opt/manga-work/runtime \
    MANGA_EXECUTION_ROOT=/opt/manga-work/execution \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/manga-work/project

# Dependencies and models remain managed by deployment/runpod/manage.py on the
# persistent /workspace volume. Baking only the application code keeps rebuilds
# quick and preserves the project's validated, hash-keyed runtime environments.
COPY --chown=root:root . /opt/manga-work/project

# Fail the image build on Python syntax errors without retaining bytecode.
RUN python3 -m compileall -q \
      run.py src deployment/runpod scripts \
    && find . -type d -name __pycache__ -prune -exec rm -rf {} +

# Do not replace the base image entrypoint/CMD: /start.sh must remain in control
# so Runpod can initialize SSH and keep the Pod alive.
